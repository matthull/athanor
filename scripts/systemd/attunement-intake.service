[Unit]
Description=Attunement intake — invoke perceiver to process attunement signals

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n -E 0 /tmp/claude-attunement-intake.lock /home/matt/.local/bin/attunement-intake-check
Environment=HOME=/home/matt
Environment=PATH=/home/matt/.local/bin:/usr/local/bin:/usr/bin
Environment=ATHANOR=/home/matt/athanor/athanors/athanor-architect
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
